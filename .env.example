# 复制为 .env 后填写。变量大小写不敏感，额外字段会被忽略

# ── 必填 ──────────────────────────────────────────────────────────────
# 数据库连接串。示例：mysql+aiomysql://user:password@127.0.0.1:3306/cquptddl
# 本地开发也可用 SQLite：sqlite+aiosqlite:///./test.db
DATABASE_URL=

# JWT 签名密钥，同时派生 AES 密钥
# 注意：上线后更换会让已存的平台密码/凭据全部无法解密
SECRET_KEY=

# QQ 机器人（qqchan）地址，以及双向鉴权的两个 key。
# recv = 后端发往机器人；send = 机器人发往后端。命名与 qqbot 端一致，不对称是故意的
QQBOT_URL=
QQBOT_RECV_API_KEY=
QQBOT_SEND_API_KEY=

# ── 可选（以下为默认值）───────────────────────────────────────────────
DEBUG=false

# 设为前端构建产物目录时，后端会以同源方式托管静态文件；留空则只提供 API
FRONTEND_DIR=

# 数据库
db_echo=false
db_pool_pre_ping=true
db_pool_recycle=3600

# 登录
qr_login_session_ttl=180

# 作业刷新
homework_cache_base_ttl=43200
homework_cache_jitter=1800
homework_cooldown_ttl=1800
homework_refresh_attempts=3

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# Meet 课程表同步间隔（秒）
meetschedule_sync_interval=300

# ICS 日历订阅
ics_timezone=Asia/Shanghai
ics_event_duration_minutes=30
ics_past_days=30
